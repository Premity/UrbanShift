# ── UrbanShift Demo Environment ─────────────────
LLM_PROFILE=demo

# Database
POSTGRES_USER=urbanshift
POSTGRES_PASSWORD=urbanshift_demo
POSTGRES_DB=urbanshift
DATABASE_URL=postgresql+asyncpg://urbanshift:urbanshift_demo@db:5432/urbanshift

# LLM Keys (demo: Gemini Pro + Flash)
GOOGLE_API_KEY=your_gemini_api_key_here

# Adzuna Job API
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# LangSmith (optional tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=urbanshift-demo
